<Window x:Class="AIQuotaMonitor.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage history" Width="780" Height="540"
        Icon="app.ico" WindowStartupLocation="CenterOwner" Background="#1B1B22">
    <!-- Mica 透出时的 tint 层（Win10 回退为窗口实色背景） -->
    <Border Background="#E61B1B22" CornerRadius="8">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="&#xE74E;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                    Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0" Click="Export_Click"/>
            <StackPanel x:Name="RangePanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Foreground="#EDEDF2" VerticalAlignment="Center"/>
            <StackPanel x:Name="LegendPanel" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1" Background="#15151C" CornerRadius="8" Padding="6">
            <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
        </Border>
        <WrapPanel x:Name="StatsPanel" Grid.Row="2" Margin="2,10,0,0"/>
    </Grid>
    </Border>
</Window>
