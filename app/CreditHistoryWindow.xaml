<Window x:Class="AIQuotaMonitor.CreditHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credit usage" Width="840" Height="580" MinWidth="680" MinHeight="480"
        Icon="app.ico" WindowStartupLocation="CenterOwner" Background="#1B1B22">
    <Window.Resources>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="#15151C"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="CaretBrush" Value="#E8E8EC"/>
            <Setter Property="SelectionBrush" Value="#3FB950"/>
        </Style>
    </Window.Resources>
    <Border Background="#E61B1B22" CornerRadius="8">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#EDEDF2"/>
                <TextBlock x:Name="LocalTipText" FontSize="10.5" Foreground="#8A8A95" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12" VerticalAlignment="Center">
                <TextBlock x:Name="StartLabel" Foreground="#8A8A95" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="StartDatePicker" Width="132" Background="#15151C" Foreground="#E8E8EC"
                            SelectedDateChanged="DateRange_Changed"/>
                <TextBlock x:Name="EndLabel" Foreground="#8A8A95" FontSize="11" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <DatePicker x:Name="EndDatePicker" Width="132" Background="#15151C" Foreground="#E8E8EC"
                            SelectedDateChanged="DateRange_Changed"/>
                <Button x:Name="Last30Button" Style="{StaticResource AccentButtonStyle}" Margin="16,0,0,0" Click="Last30_Click"/>
            </StackPanel>
            <Border Grid.Row="2" Background="#15151C" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8">
                <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
            </Border>
            <WrapPanel x:Name="StatsPanel" Grid.Row="3" Margin="2,12,0,0"/>
        </Grid>
    </Border>
</Window>
